{
  "version": 2,
  "buildCommand": "node server/migrate.js && cd client && npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/[[catchAll]].js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/auth/(.*)", "destination": "/api/auth/$1" },
    { "source": "/sessions/(.*)", "destination": "/api/sessions/$1" },
    { "source": "/submissions/(.*)", "destination": "/api/submissions/$1" },
    { "source": "/admin/(.*)", "destination": "/api/admin/$1" },
    { "source": "/rubrics/(.*)", "destination": "/api/rubrics/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
